// Memory.hdl - Hack data memory map
// Ajitesh Singh Gusain | Roll No. 2501630014 | K = 14
//
//   0     - 16383 : RAM16K
//   16384 - 24575 : Screen (8K)
//   24576         : Keyboard
//
// address[14..13]: 00 and 01 -> RAM, 10 -> Screen, 11 -> Keyboard

CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:
    // Route the load bit to the right device
    DMux4Way(in=load, sel=address[13..14], a=loadRamA, b=loadRamB, c=loadScreen, d=loadKbd);
    Or(a=loadRamA, b=loadRamB, out=loadRam);

    RAM16K(in=in, load=loadRam, address=address[0..13], out=ramOut);
    Screen(in=in, load=loadScreen, address=address[0..12], out=screenOut);
    Keyboard(out=kbdOut);

    // Select which device drives the output
    Mux4Way16(a=ramOut, b=ramOut, c=screenOut, d=kbdOut, sel=address[13..14], out=out);
}
