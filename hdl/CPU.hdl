// CPU.hdl - Hack CPU
// Ajitesh Singh Gusain | Roll No. 2501630014 | K = 14
//
// Instruction format:
//   A-instruction: 0vvv vvvv vvvv vvvv
//   C-instruction: 111a cccc ccdd djjj
//     instruction[15]    = 1 for C-instruction
//     instruction[12]    = a bit  (0: ALU uses A, 1: ALU uses M)
//     instruction[11..6] = zx nx zy ny f no (ALU control bits)
//     instruction[5]     = d1 (store in A)
//     instruction[4]     = d2 (store in D)
//     instruction[3]     = d3 (store in M)
//     instruction[2..0]  = j1 j2 j3 (jump if out<0, out=0, out>0)

CHIP CPU {

    IN  inM[16],         // M value input  (M = contents of RAM[A])
        instruction[16], // Instruction for execution
        reset;           // Signals whether to re-start the current program

    OUT outM[16],        // M value output
        writeM,          // Write to M?
        addressM[15],    // Address in data memory (of M)
        pc[15];          // address of next instruction

    PARTS:
    // ---------- Instruction type ----------
    Not(in=instruction[15], out=isAInstr);

    // ---------- A register ----------
    // If A-instruction: load the instruction value; if C-instruction: load ALU output
    Mux16(a=instruction, b=aluOut, sel=instruction[15], out=aRegIn);
    // A register is loaded for every A-instruction, or for a C-instruction with d1=1
    Or(a=isAInstr, b=instruction[5], out=loadA);
    ARegister(in=aRegIn, load=loadA, out=aOut, out[0..14]=addressM);

    // ---------- ALU second input: A or M ----------
    Mux16(a=aOut, b=inM, sel=instruction[12], out=aluY);

    // ---------- D register (only for C-instruction with d2=1) ----------
    And(a=instruction[15], b=instruction[4], out=loadD);
    DRegister(in=aluOut, load=loadD, out=dOut);

    // ---------- ALU ----------
    ALU(x=dOut, y=aluY,
        zx=instruction[11], nx=instruction[10],
        zy=instruction[9],  ny=instruction[8],
        f=instruction[7],   no=instruction[6],
        out=aluOut, out=outM, zr=zr, ng=ng);

    // ---------- writeM (only for C-instruction with d3=1) ----------
    And(a=instruction[15], b=instruction[3], out=writeM);

    // ---------- Jump logic ----------
    Or(a=zr, b=ng, out=zeroOrNeg);
    Not(in=zeroOrNeg, out=pos);                 // out > 0
    And(a=instruction[2], b=ng,  out=jLT);      // j1 and out<0
    And(a=instruction[1], b=zr,  out=jEQ);      // j2 and out=0
    And(a=instruction[0], b=pos, out=jGT);      // j3 and out>0
    Or(a=jLT, b=jEQ, out=jLE);
    Or(a=jLE, b=jGT, out=jumpCond);
    And(a=instruction[15], b=jumpCond, out=jump); // jumps only happen in C-instructions

    // ---------- Program Counter ----------
    PC(in=aOut, load=jump, inc=true, reset=reset, out[0..14]=pc);
}
